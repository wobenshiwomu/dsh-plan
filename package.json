{
  "name": "dsh-plan",
  "version": "0.1.3",
  "description": "DeepSeek Harness 插件：深潜计划 —— DSH 里的自营「套餐页」。七档订阅（¥10~自定义），订阅跳官方充值页；充值回来自动把额度写进 dsh-ration，钱进你自己的余额",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "dsh-plan",
    "coding-plan",
    "subscription",
    "quota",
    "套餐",
    "深潜计划"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/sim.mjs",
    "build": "node scripts/build-client.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-commands": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "esbuild": "^0.25.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wobenshiwomu/dsh-plan.git"
  }
}
